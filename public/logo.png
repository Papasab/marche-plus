<svg width="560" height="140" viewBox="0 0 560 140" xmlns="http://www.w3.org/2000/svg">
  <!-- Fond sombre -->
  <rect x="0" y="0" width="560" height="140" rx="16" fill="#1a1a1a"/>

  <!-- Icône sac -->
  <g transform="translate(60, 70)">
    <rect x="-28" y="-22" width="56" height="44" rx="8" fill="none" stroke="#ffffff" stroke-width="2.5"/>
    <path d="M-14 -22 Q-14 -38 0 -38 Q14 -38 14 -22" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="-28" y1="-4" x2="28" y2="-4" stroke="#ffffff" stroke-width="1" opacity="0.4"/>
    <circle cx="0" cy="8" r="4" fill="none" stroke="#ffffff" stroke-width="2"/>
  </g>

  <!-- Texte MARCHÉ -->
  <text x="115" y="56" font-family="'Inter', 'Segoe UI', sans-serif" font-size="38" font-weight="700" fill="#ffffff" letter-spacing="-1">MARCHÉ</text>
  <!-- + en or -->
  <text x="430" y="56" font-family="'Inter', 'Segoe UI', sans-serif" font-size="42" font-weight="700" fill="#f5a623">+</text>
  <!-- Tagline -->
  <text x="115" y="88" font-family="'Inter', 'Segoe UI', sans-serif" font-size="13" font-weight="400" fill="#ffffff" opacity="0.6" letter-spacing="3">BOUTIQUE EN LIGNE</text>
  <!-- Ligne dorée -->
  <line x1="115" y1="100" x2="450" y2="100" stroke="#f5a623" stroke-width="1.5" opacity="0.6"/>
</svg>
